# Site settings for BlueBEAR. Copy to slurm/bluebear.local.sh (ignored by git) and edit the three values.
#   cp slurm/bluebear.local.sh.example slurm/bluebear.local.sh

# Big files (raw downloads + intermediate rasters, allow ~100 GB). Must be in your RDS project, not in home.
export ASHWATCH_DATA=/rds/projects/X/PROJECT/ashwatch_data

# Where the Python virtual environments live (one per node type is created automatically).
VENV_DIR=/rds/projects/X/PROJECT/venvs

# Modules that provide Python 3.11 or 3.12, in load order. Find the names on a login node with:
#   module purge; module load bluebear; module avail bear-apps; module avail Python
# Format example (check that this exact version exists before using it):
#   BEAR_MODULES="bear-apps/2023a Python/3.11.3-GCCcore-12.3.0"
BEAR_MODULES="CHANGE_ME"
