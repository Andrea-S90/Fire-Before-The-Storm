# Site settings for BlueBEAR. Copy to slurm/bluebear.local.sh (ignored by git) and edit the two paths.
#   cp slurm/bluebear.local.sh.example slurm/bluebear.local.sh
# The job scripts run `module purge; module load bluebear` and then source this file.

# Big files (raw downloads + intermediate rasters). Must be in your RDS project, not in home.
export ASHWATCH_DATA=/rds/projects/X/PROJECT/ashwatch_data

# Where the Python virtual environments live (one per node type is created automatically).
VENV_DIR=/rds/projects/X/PROJECT/venvs

# Modules that provide Python 3.11 or 3.12, written exactly as in a job script.
# If these versions are gone, list what exists with:  module avail bear-apps; module avail Python
module load bear-apps/2024a
module load Python/3.12.3-GCCcore-13.3.0
